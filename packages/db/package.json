{
  "name": "@wanderly/db",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "seed": "tsx src/seed.ts",
    "seed:invites": "tsx src/seed-invites.ts",
    "seed:destinations": "tsx -e \"import('./src/seed.ts').then(m => m.seedDestinations().then(() => process.exit(0)))\"  ",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "mongoose": "^8.9.0",
    "mongodb": "^6.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "@wanderly/config": "workspace:*",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4"
  }
}
